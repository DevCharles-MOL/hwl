# Copia este archivo como .env y reemplaza los valores para tu equipo.
# No compartas ni subas .env; el archivo está excluido por .gitignore.
DB_URL=jdbc:postgresql://localhost:5432/hwd
DB_USERNAME=postgres
DB_PASSWORD=
SERVER_PORT=8080

# Usa valores aleatorios propios y estables. No los cambies después de activar MFA.
MFA_ENCRYPTION_PASSWORD=reemplaza-por-una-clave-aleatoria-larga
MFA_ENCRYPTION_SALT=0123456789abcdef

# Opcional: se crea un administrador inicial solo si defines ambos valores.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP: usa credenciales SMTP de tu proveedor, nunca tu contraseña normal.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_MAX_RESENDS_PER_HOUR=5
